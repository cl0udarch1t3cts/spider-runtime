# Official stock Hermes Agent v2026.8.18, pinned to its multi-architecture manifest digest.
SPIDER_DOCTOR_HERMES_DIGEST=sha256:22e37bb4ed1b0f50cb6bd991dca7ecacd6c9f29df9b4a20fc989d32bc763ccf6
SPIDER_DOCTOR_MODEL=gpt-5.4

# Absolute host paths are required because Doctor launches disposable containers
# through the host Docker daemon and both sides must resolve the same bind paths.
SPIDER_DOCTOR_HOST_ROOT=/home/spider/projects/spider-doctor
SPIDER_SCRIPTS_HOST_PATH=/home/spider/projects/spider-scripts
SPIDER_DOCTOR_SSH_HOST_PATH=/home/spider/.ssh

# Obtain these with: id -u; id -g; stat -c %g /var/run/docker.sock
SPIDER_DOCTOR_UID=1000
SPIDER_DOCTOR_GID=1000
SPIDER_DOCTOR_DOCKER_GID=999

SPIDER_EXECUTOR_CONTROL_NETWORK=spider-executor_control
SPIDER_DOCTOR_NETWORK=spider-doctor-egress
SPIDER_DOCTOR_PUBLICATION_BRANCH=main
